---
// Decorative dusk backdrop: shader sky (Three.js), SVG scenery,
// readability scrim and fireflies. Persisted across view transitions.
---
<div class="sky" aria-hidden="true" transition:persist="sky">
  <canvas class="sky__canvas" id="sky-canvas"></canvas>
</div>

<svg class="scenery" viewBox="0 0 1440 400" preserveAspectRatio="xMidYMax slice" aria-hidden="true" transition:persist="scenery">
  <g fill="#0c0a08">
    <path d="M0,400 L0,250 C120,238 180,150 300,176 C362,190 402,236 520,251 C700,276 900,262 1100,278 C1250,289 1360,281 1440,287 L1440,400 Z"/>
    <path d="M60,250 l-3,-30 l6,2 l-1,28 Z M92,247 l2,-34 l5,4 l-3,30 Z M128,244 l-2,-26 l5,1 l1,25 Z M980,272 l-2,-30 l6,3 l-1,27 Z M1010,274 l3,-26 l5,3 l-3,23 Z"/>
    <g>
      <rect x="1096" y="220" width="7" height="60"/>
      <ellipse cx="1099" cy="212" rx="42" ry="34"/>
      <ellipse cx="1072" cy="224" rx="26" ry="22"/>
      <ellipse cx="1126" cy="224" rx="28" ry="23"/>
    </g>
    <g>
      <rect x="1224" y="236" width="6" height="46"/>
      <ellipse cx="1227" cy="228" rx="30" ry="25"/>
      <ellipse cx="1250" cy="238" rx="20" ry="17"/>
    </g>
    <polygon points="527,274 595,274 568,60 554,60"/>
    <rect x="510" y="90" width="102" height="6"/>
    <rect x="500" y="116" width="122" height="6"/>
    <rect x="516" y="142" width="90" height="5"/>
    <polygon points="554,60 568,60 561,44"/>
    <g stroke="#0c0a08" stroke-width="2" fill="none">
      <path d="M540,251 L582,142 M582,251 L540,142 M544,142 L578,96 M578,142 L544,96"/>
    </g>
    <circle cx="512" cy="100" r="2.5"/>
    <circle cx="610" cy="100" r="2.5"/>
    <circle cx="502" cy="126" r="2.5"/>
    <circle cx="620" cy="126" r="2.5"/>
    <polygon points="1340,286 1360,286 1353,196 1347,196"/>
    <rect x="1332" y="210" width="36" height="3"/>
    <rect x="1328" y="224" width="44" height="3"/>
  </g>
  <g stroke="#0c0a08" stroke-width="1.6" fill="none" opacity="0.9">
    <path d="M512,100 Q360,150 240,182"/>
    <path d="M610,100 Q900,150 1150,192"/>
    <path d="M502,126 Q380,176 250,210"/>
    <path d="M620,126 Q950,176 1200,214"/>
    <path d="M1150,192 Q1250,196 1332,211"/>
  </g>
  <!-- distant birds -->
  <g stroke="#0c0a08" stroke-width="2" fill="none" opacity="0.7">
    <path d="M300,90 q10,-8 20,0 q10,-8 20,0"/>
    <path d="M360,110 q7,-6 14,0 q7,-6 14,0"/>
    <path d="M840,74 q8,-7 16,0 q8,-7 16,0"/>
  </g>
</svg>

<div class="scrim" aria-hidden="true" transition:persist="scrim"></div>

<!-- Fireflies (decorative) -->
<div class="fireflies" aria-hidden="true" transition:persist="fireflies">
  <span class="firefly" style="bottom:18%;left:32%"></span>
  <span class="firefly" style="bottom:26%;left:48%;animation-delay:1.4s"></span>
  <span class="firefly" style="bottom:14%;left:64%;animation-delay:.8s"></span>
  <span class="firefly" style="bottom:30%;left:74%;animation-delay:2.2s"></span>
  <span class="firefly" style="bottom:22%;left:40%;animation-delay:3s"></span>
</div>
