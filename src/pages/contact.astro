---
import Base from '../layouts/Base.astro';
---

<Base
  title="Contact · Nicolas Robinet"
  description="A project, a contract, or just a friendly hello before the light goes. Reach out to Nicolas Robinet any time."
>
  <section class="page" id="contact" aria-labelledby="contact-title">
    <p class="eyebrow">Say hello</p>
    <h2 class="page-title" id="contact-title">Contact</h2>
    <p class="lede">A project, a contract, or just a friendly hello before the light goes. The door is open, reach out any time.</p>

    <a class="contact__row" href="mailto:nicolasrobinet.work@gmail.com">
      <span class="contact__label">Email</span>
      <span class="contact__value">nicolasrobinet.work@gmail.com</span>
    </a>
    <a class="contact__row" href="https://github.com/Nicolas-Robinet" target="_blank" rel="noopener">
      <span class="contact__label">GitHub</span>
      <span class="contact__value">@Nicolas-Robinet</span>
    </a>
    <!-- Add your profile URLs to enable:
    <a class="contact__row" href="" target="_blank" rel="noopener">
      <span class="contact__label">LinkedIn</span>
      <span class="contact__value">in/your-handle</span>
    </a>
    -->
  </section>
</Base>
