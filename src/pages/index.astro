---
import Base from '../layouts/Base.astro';
import Divider from '../components/Divider.astro';
---

<Base title="Nicolas Robinet">
  <section class="page" id="home" aria-labelledby="home-title">
    <p class="eyebrow">Full-stack developer</p>
    <h2 class="page-title page-title--hero" id="home-title">Web apps built<br />end to end.</h2>
    <p class="lede">Freelance full-stack developer. I design, build and ship web applications that hold up in real use, from first commit to production.</p>

    <Divider />

    <p class="prose">I am <span class="hl">Nicolas Robinet</span>, a full-stack developer working mainly with TypeScript, React and Node.js. I take on client projects from start to finish, from the empty repository to the clean deploy.</p>
    <p class="prose">When I am not building for clients I am studying cloud infrastructure, putting Kubernetes, Docker and AWS to work on my own projects.</p>

    <div class="cards">
      <a class="card" href="/projects">
        <span class="card__label">Selected work</span>
        <span class="card__row"><span class="card__title">Explore my work</span><span class="card__more">see them &#8594;</span></span>
      </a>
      <a class="card" href="/journal">
        <span class="card__label">From the journal</span>
        <span class="card__row"><span class="card__title">Read the journal</span><span class="card__more">read &#8594;</span></span>
      </a>
      <div class="card card--static">
        <span class="card__label">Currently studying</span>
        <span class="card__row"><span class="card__title card__title--muted">AWS &middot; Kubernetes &middot; Docker</span></span>
      </div>
    </div>
  </section>
</Base>
